# SimpleRecord 发布构建注入的云同步配置（Env 文件格式）。
#
# 用法：
#   复制本文件为 .env.release（已被 .gitignore 忽略，不会提交远端），
#   填上自己的服务密钥后，构建时用 --dart-define-from-file 注入：
#     flutter build windows --release --dart-define-from-file=.env.release
#     flutter build apk --release --dart-define-from-file=.env.release
#
# 取值为空（如本地开发未注入）时，云同步功能不可用（登录/共享账本）。

# Supabase 项目地址，形如 https://xxxx.supabase.co
SUPABASE_URL=

# 公共匿名 key（anon / publishable），在 Dashboard -> Settings -> API 获取。
# anon key 设计为公开可分发给客户端；数据库安全由 RLS 控制，勿填写 service_role key。
SUPABASE_ANON_KEY=